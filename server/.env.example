# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/outbound-si
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Set to 1 when the app sits behind a proxy or load balancer (Render, Railway, Fly, Nginx) so rate limits see real visitor IPs
TRUST_PROXY=1
# First admin, created by `npm run seed`
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=
# Optional: a code for previews. Disable it in the admin panel before launch.
PREVIEW_CODE=
# Optional: lets your payment tool create access codes (see README). Leave empty to switch the webhook off.
WEBHOOK_SECRET=
# 1:1 strategy call upsell
CALL_ENABLED=1
CALL_PRICE=Rs 10,000
CALL_MINUTES=60
CALL_PAY_URL=
CALL_BOOK_URL=
# AI help. Leave AI_PROVIDER empty to keep it off: every tool still works without it.
# anthropic or openai. AI_MODEL is required for openai; anthropic defaults to claude-haiku-5-5.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Limits per member. Each AI answer or check counts as one. A typed roleplay turn counts as a quarter.
AI_DAILY_LIMIT=5
AI_MONTHLY_LIMIT=30
